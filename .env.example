# Google Gemini API Key (Required for Fast Cloud LLM Generation)
GOOGLE_API_KEY=AIzaSyYourActualApiKeyHere

# Allowed CORS Origins for Frontend (Use * or comma-separated list of origins)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Server Port
PORT=8000

# RAG & PDF Protection Performance Parameters
MAX_PDF_SIZE_MB=50
MAX_PDF_PAGES=200
CHUNK_SIZE=700
CHUNK_OVERLAP=70
EMBEDDING_BATCH_SIZE=32
TOP_K=4
LLM_TIMEOUT_SECONDS=30

